{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBranchManager",
  "version": "0.1.0",
  "identifier": "com.gitbranchmanager.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Branch Manager - Git 分支管理工具",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NDUyMDdDNzUzNTE1MjAKUldRZ0ZUVjFmQ0JGeUdlSlNGMkxiSStFNk1NWE50TkFlcUhNY256T0lzcnlUZFVzSWxzVDM1L3AK",
      "endpoints": ["https://github.com/henrique-X/GitBranchManager/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
